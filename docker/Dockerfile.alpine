# Stable upstream images are pinned to their multi-platform manifest digests.
FROM rust:1.99.1-alpine3.24@sha256:44819b27be4c97b0e4d7203bd2e02c4820f97700211b6a37fb4c246a2de59383 AS builder

# Official 1.100.0 Alpine images are not published yet. This verified image is
# bootstrap-only; install and prove the active stable compiler before building.
ENV RUST_VERSION=1.100.0
RUN rustup toolchain install 1.100.0 --profile minimal --no-self-update --component clippy --component rustfmt && \
    rustup default 1.100.0 && \
    rustup toolchain uninstall 1.99.1 && \
    rustc --version | grep -E '^rustc 1\.100\.0 ' && \
    cargo --version
# Distribution packages receive security updates during builds.
RUN apk add --no-cache build-base cmake perl pkgconfig
WORKDIR /app
# Copy build inputs explicitly: security reports and workflow edits do not
# invalidate native compilation, and no generated credentials enter this stage.
COPY Cargo.toml Cargo.lock rust-toolchain.toml README.md LICENSE ./
COPY fluxencrypt/ fluxencrypt/
COPY fluxencrypt-cli/ fluxencrypt-cli/
COPY fluxencrypt-async/ fluxencrypt-async/
COPY tests/ tests/
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
ENV RUSTFLAGS="-C target-feature=-crt-static"
RUN cargo build --locked --release --package fluxencrypt-cli --all-features

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk add --no-cache ca-certificates libgcc && adduser -D fluxencrypt
COPY --from=builder /app/target/release/fluxencrypt-cli /usr/local/bin/fluxencrypt-cli
RUN mkdir -p /data && chown fluxencrypt:fluxencrypt /data
USER fluxencrypt
WORKDIR /data
ARG VERSION=latest
LABEL org.opencontainers.image.title="FluxEncrypt" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/ThreatFlux/FluxEncrypt" \
      org.opencontainers.image.licenses="MIT"
ENTRYPOINT ["/usr/local/bin/fluxencrypt-cli"]
CMD ["--help"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/fluxencrypt-cli --version || exit 1
